toric":"not_legal","timeless":"not_legal","pauper":"legal","commander":"legal","brawl":"not_legal","legacy":"legal","vintage":"legal"},"imageUrl":"https://cards.scryfall.io/normal/front/b/9/b9b28f37-d6b8-4d35-95e9-9533aea0a071.jpg?1562836109","thumbnailUrl":"https://cards.scryfall.io/small/front/b/9/b9b28f37-d6b8-4d35-95e9-9533aea0a071.jpg?1562836109","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["enchantment"],"printedNames":["Careta Esquelética"]},{"id":"5a96d8ae-200a-40be-95a8-72b53638a090","oracleId":"c3775748-ff62-469f-916b-8e551ccce23c","lang":"en","name":"Careening Mine Cart","manaValue":3,"typeLine":"Artifact — Vehicle","oracleText":"Whenever this Vehicle attacks, create a Treasure token. (It's an artifact with \"{T}, Sacrifice this token: Add one mana of any color.\")\nCrew 1 (Tap any number of creatures you control with total power 1 or more: This Vehicle becomes an artifact creature until end of turn.)","cardTypes":["Artifact"],"colors":[],"colorIdentity":[],"keywords":["Treasure","Crew"],"legalities":{"standard":"legal","pioneer":"legal","modern":"legal","historic":"legal","timeless":"legal","pauper":"not_legal","commander":"legal","brawl":"legal","legacy":"legal","vintage":"legal"},"imageUrl":"https://cards.scryfall.io/normal/front/5/a/5a96d8ae-200a-40be-95a8-72b53638a090.jpg?1700056789","thumbnailUrl":"https://cards.scryfall.io/small/front/5/a/5a96d8ae-200a-40be-95a8-72b53638a090.jpg?1700056789","power":"3","toughness":"3","isLegendary":false,"canBeCommander":false,"tags":["artifact","mana_fixing","permanent_ramp","ramp","sacrifice","token_generator"],"printedNames":["Vagoneta Cambaleante"]},{"id":"6676e2f8-7625-4c0e-bfed-bed36fb8440c","oracleId":"9e00a6ff-4e73-4cc3-9519-bb9c12ada247","lang":"en","name":"Careful Study (minigame) // Careful Study (cont'd)","manaValue":0,"typeLine":"Card","oracleText":"2-6 players | 1 pack | 5 minutes\nOBJECTIVE:\nTake turns memorizing _Magic_ cards and trying to stump your opponent with questions!\nGET READY:\nSplit up into two teams of one or more players. Randomly determine which team goes first, and then open a pack and remove any remaining land cards and any cards without _Magic_ card backs. Each team then picks a card and puts it face down on the table without looking at it.\nLET'S PLAY:\nOn your turn, your team has 30 seconds to examine your card before handing it over to the opposing team. Then they ask your team five questions about your card. Once you've answered them all, note your score. Now it's your team's turn to ask the questions! Questions can be about anything on the card.\nFor example:\nWhat's the creature's power?\nWhat's the mana cost?\nWho's quoted in the flavor text?\nWhat's the character in the art holding?\nIs the character's mouth open?\nWho's the artist?\nWhat's the collector number?\nWhat mechanics are mentioned in the card text?\nWhat's the rarity?\nCan you see the sun or moon in the art?\nDon't ask any questions you can't accurately answer (e.g. how many blades of grass are in the art?).\nTO WIN:\nThe team who gets the most questions right wins! If there is a tie, play another round with new cards.","cardTypes":[],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/6/6/6676e2f8-7625-4c0e-bfed-bed36fb8440c.jpg?1630031781","thumbnailUrl":"https://cards.scryfall.io/small/front/6/6/6676e2f8-7625-4c0e-bfed-bed36fb8440c.jpg?1630031781","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":[],"printedNames":["Careful Study (cont'd)","Careful Study (minigame)"]}]}