scryfall.io/small/front/0/a/0a66ff6a-5194-4139-9323-e23b99a42742.jpg?1673916022","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["artifact"],"printedNames":[]},{"id":"0bb07402-d526-4938-89a3-9174d5b5a4de","oracleId":"9c47888b-28a5-4c43-9ee4-a9059e3c367d","lang":"en","name":"Rolling Thunder","manaValue":2,"typeLine":"Sorcery","oracleText":"Rolling Thunder deals X damage divided as you choose among any number of targets.","cardTypes":["Sorcery"],"colors":["R"],"colorIdentity":["R"],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"legal","modern":"legal","historic":"not_legal","timeless":"not_legal","pauper":"legal","commander":"legal","brawl":"not_legal","legacy":"legal","vintage":"legal"},"imageUrl":"https://cards.scryfall.io/normal/front/0/b/0bb07402-d526-4938-89a3-9174d5b5a4de.jpg?1593863103","thumbnailUrl":"https://cards.scryfall.io/small/front/0/b/0bb07402-d526-4938-89a3-9174d5b5a4de.jpg?1593863103","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["removal","single_target_removal","sorcery"],"printedNames":["Trovoada Ribombante"]},{"id":"2d87ef32-5b97-4c97-85e6-89c94eaffc08","oracleId":"1e3b2689-e75a-401f-9e9b-82a11283c3f1","lang":"en","name":"Roll for Initiative // Roll for Initiative (cont'd)","manaValue":0,"typeLine":"Card","oracleText":"2+ players | 1+ packs | 5 minutes | d20\nOBJECTIVE:\nAs you enter the room, the terrible dragon opens its eyes and lets out a roar. Everybody... roll for initiative! Roll a d20 and modify the result with some _Magic_ cards to get the highest initiative!\nGET READY:\nOpen a booster and remove all cards without _Magic_ card backs. Use an additional booster for groups of five players or more. Shuffle, then deal the same number of cards to each player. If there are extra cards after dealing, set them aside. Each player then rolls a d20 to determine their *initiative*. In case of a tie, the tied players roll again. The player with the lowest starting initiative goes first.\nLET'S PLAY:\nOn each player's turn, they play a card to modify a player's initiative (see reverse side for card effects). Cards with effects that will be counted at the end of the game should be placed in front of the target player. All other cards go into the discard pile.\nPlay continues until all players are out of cards.\n*White Card*: At the end of the game, increase a player's roll by 2.\n*Blue Card*: Reroll another player's die, but use the new result only if it's lower.\n*Black Card*: At the end of the game, decrease a player's roll by 2.\n*Red Card*: Reroll another player's die. They must use the new result.\n*Green Card*: Reroll your own die, but use the new result only if it's higher.\n*Colorless Card*: Each player may reroll their die. if they do, they must use the new result.\n*Multicolored Card*: Apply the effects of each of the card's colors. Each effect can target a different player.\n*Any Card Played Face Down*: At the end of the game, increase or decrease a player's die roll by 1.\nTO WIN:\nOnce everyone is out of cards, check to see who has the highest roll. That player wins initiative!","cardTypes":[],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/2/d/2d87ef32-5b97-4c97-85e6-89c94eaffc08.jpg?1630032735","thumbnailUrl":"https://cards.scryfall.io/small/front/2/d/2d87ef32-5b97-4c97-85e6-89c94eaffc08.jpg?1630032735","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["discard"],"printedNames":["Roll for Initiative","Roll for Initiative (cont'd)"]},{"id":"3c1bf210-ecdb-4b49-8504-51360c269e66","oracleId":"46b96552-830e-4732-9560-9872aeec858b","lang":"en","name":"Rolling Earthquake","manaValue":1,"typeLine":"Sorcery","oracleTe