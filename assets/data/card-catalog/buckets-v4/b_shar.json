],"colors":[],"colorIdentity":[],"keywords":["Scry"],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/6/a/6a198942-049c-4537-b5b1-d35df32d45d5.jpg?1726236836","thumbnailUrl":"https://cards.scryfall.io/small/front/6/a/6a198942-049c-4537-b5b1-d35df32d45d5.jpg?1726236836","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["card_draw","card_selection","enchantment","sacrifice"],"printedNames":[]},{"id":"732e594a-4efa-4683-a0de-515f59dfe694","oracleId":"280d7480-88d6-4783-a6d2-ba45ee8b03b6","lang":"en","name":"Sharp Eraser","manaValue":6,"typeLine":"Artifact","oracleText":"{2}, {T}: Reveal cards from the top of your library until you reveal a nonland card. You may erase any number of words on the card, including flavor text, as long as the card still makes sense. Then cast the revised card without paying its mana cost. Put all other cards revealed this way on the bottom of your library in a random order.","cardTypes":["Artifact"],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/7/3/732e594a-4efa-4683-a0de-515f59dfe694.jpg?1732285346","thumbnailUrl":"https://cards.scryfall.io/small/front/7/3/732e594a-4efa-4683-a0de-515f59dfe694.jpg?1732285346","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["artifact"],"printedNames":[]},{"id":"b1e0fc39-93b4-4266-bd29-d280f883e316","oracleId":"50378a49-5875-4ef1-98d1-b6c64d9ac93c","lang":"en","name":"Sharkey's Tithe // Sharkey's Tithe (cont'd)","manaValue":0,"typeLine":"Card","oracleText":"2 or more players | 1 pack per player | 10 minutes\nOBJECTIVE:\nSharkey and his ruffians have taken over the Shire and are tithing you and the other Hobbits of Hobbiton! Try to hold on to your valuable heirlooms without losing them to these extorters.\nGET READY:\nEach player opens a booster, sets aside all cards without *Magic* card backs, then shuffles the remaining cards to form their face-down deck.\nLET'S PLAY:\nEach round, players draw until they have four cards. Players then place two cards from their hand face down in front of them as heirlooms. Once heirlooms have been chosen, all players reveal them simultaneously and add up the mana values of their own cards.\nThe player(s) with the highest total mana value discards their heirlooms. Sharkey has claimed them as payment! If any player's payment includes a land card, that player instead places the land in their bank to be counted later—you hold on to your home no matter what.\nEach other player puts their two cards into their bank to be counted later. Sharkey's greed has caused them to be overlooked.\nTO WIN:\nAfter *five* rounds, discard any remaining cards. Each player counts the mana values in their bank and earns that many points. Lands are worth 3 points. The player with the most points wins! Players who tie share the victory.","cardTypes":[],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/b/1/b1e0fc39-93b4-4266-bd29-d280f883e316.jpg?1752742950","thumbnailUrl":"https://cards.scryfall.io/small/front/b/1/b1e0fc39-93b4-4266-bd29-d280f883e316.jpg?1752742950","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["discard"],"printedNames":["Sharkey's Tithe","Sharkey's Tithe (cont'd)"]}]}