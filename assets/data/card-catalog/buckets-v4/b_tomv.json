{"aliases":{"tom van de logt decklist 2000":0,"tom van de logt bio 2000":1,"tom van de logt bio 2001":2,"tom van de logt decklist 2001":3},"cards":[{"id":"0e4702c0-1999-4982-aef8-1af478f1d511","oracleId":"70d4fb47-5fcf-4d69-a6d5-2a1a8ca7a790","lang":"en","name":"Tom van de Logt Decklist (2000)","manaValue":0,"typeLine":"Card","oracleText":"","cardTypes":[],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/0/e/0e4702c0-1999-4982-aef8-1af478f1d511.jpg?1562766536","thumbnailUrl":"https://cards.scryfall.io/small/front/0/e/0e4702c0-1999-4982-aef8-1af478f1d511.jpg?1562766536","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":[],"printedNames":[]},{"id":"4330efa7-a11b-4776-9fb0-1cae8aed67b1","oracleId":"5ac06f89-3088-4ed6-8901-47dbc90716ca","lang":"en","name":"Tom van de Logt Bio (2000)","manaValue":0,"typeLine":"Card","oracleText":"Quarterfinalist Tom van de Logt posted a perfect 6—0 record during the Standard portion of this year's World Championships. The 19-year-old Groesbeek, Holland native was playing a deck that had a big impact on the metagame this year, \"Replenish.\" This deck used cards like Attunement and Frantic Search to put powerful enchantments, such as Parallax Wave and Opalescence, into the graveyard and then used Replenish to put them all back into play at once.","cardTypes":[],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/4/3/4330efa7-a11b-4776-9fb0-1cae8aed67b1.jpg?1562767017","thumbnailUrl":"https://cards.scryfall.io/small/front/4/3/4330efa7-a11b-4776-9fb0-1cae8aed67b1.jpg?1562767017","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":["graveyard_synergy"],"printedNames":[]},{"id":"67f1746f-4f15-48da-9de7-3dd62811afdb","oracleId":"169918f0-a29d-429a-b236-ecc4d5cf028f","lang":"en","name":"Tom van de Logt Bio (2001)","manaValue":0,"typeLine":"Card","oracleText":"Tom van de Logt is the 2001 Netherlands National Champion as well as one of an elite group of players who have posted back-to-back World Championship Top 8 performances. Currently a student in Groesbeek, van de Logt posted an impressive 5—1 record in the Standard portion of this year's Worlds. He described his aggressive black-red \"Machine Head\" deck as \"the deck that beats the deck that beats 'Fires.'\" He liked the explosive \"I win\" draws that his deck provided, and he especially liked the way it performed against blue decks.","cardTypes":[],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander":"not_legal","brawl":"not_legal","legacy":"not_legal","vintage":"not_legal"},"imageUrl":"https://cards.scryfall.io/normal/front/6/7/67f1746f-4f15-48da-9de7-3dd62811afdb.jpg?1562490594","thumbnailUrl":"https://cards.scryfall.io/small/front/6/7/67f1746f-4f15-48da-9de7-3dd62811afdb.jpg?1562490594","power":null,"toughness":null,"isLegendary":false,"canBeCommander":false,"tags":[],"printedNames":[]},{"id":"9b4e9e76-677c-479a-949e-d7e47372bc58","oracleId":"eb8e5b78-9f04-4ac5-9a64-1f6cf2e384f9","lang":"en","name":"Tom van de Logt Decklist (2001)","manaValue":0,"typeLine":"Card","oracleText":"","cardTypes":[],"colors":[],"colorIdentity":[],"keywords":[],"legalities":{"standard":"not_legal","pioneer":"not_legal","modern":"not_legal","historic":"not_legal","timeless":"not_legal","pauper":"not_legal","commander